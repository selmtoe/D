{
  "name": "daifugo-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "3Dオンライン大富豪",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint apps functions packages",
    "format:check": "prettier --check .",
    "dev": "pnpm --filter @daifugo/web dev",
    "emulators": "firebase emulators:start",
    "ai:dry-run": "python tools/ai/train.py --dry-run --device cpu",
    "ai:smoke": "python tools/ai/train.py --device cpu --epochs 1 --max-matches 4 --run-name cpu-smoke",
    "ai:selfplay": "pnpm --filter @daifugo/web exec vitest run src/test/qaBotEvidence.test.ts",
    "ai:train:selfplay": "python tools/ai/train.py --device cuda --epochs 60 --batch-size 256 --learning-rate 0.0002 --hidden-dim 128 --validation-fraction 0.2 --test-fraction 0.2 --run-name rtx5060-selfplay-v3",
    "ai:export-web": "python tools/ai/export_web.py artifacts/ai/runs/rtx5060-selfplay-v3/policy.pt apps/web/src/ai/cpu-policy-v3.json --sha256 2dba4efb677c6664ca543b31ce08882dafb7127a6969dd0852dc9486724910f8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
