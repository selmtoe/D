rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isV2RoomMember(roomId, uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/v2Rooms/$(roomId))
        && get(/databases/$(database)/documents/v2Rooms/$(roomId)).data.members.keys().hasAny([uid])
        && get(/databases/$(database)/documents/v2Rooms/$(roomId)).data.members[uid].connectionStatus != 'left';
    }

    function isSparkRoomStale(roomId) {
      return exists(/databases/$(database)/documents/sparkRoomDirectory/$(roomId))
        && (
          (
            get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.keys()
              .hasAll(['lastActivityAt'])
            && get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.lastActivityAt
              is timestamp
            && request.time
              > get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.lastActivityAt
                + duration.value(30, 'm')
          )
          || (
            !get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.keys()
              .hasAny(['lastActivityAt'])
            && get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.heartbeatAt
              is timestamp
            && request.time
              > get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.heartbeatAt
                + duration.value(30, 'm')
          )
        );
    }

    // Legacy v1 namespace. The deployed legacy policy is not present in this
    // repository. Keeping its direct-client access preserves the running app;
    // do not tighten this match until the documented migration is complete.
    match /rooms/{document=**} {
      allow read, write: if true;
    }

    // Full card state is server-authoritative. Admin SDK access bypasses Rules.
    match /v2Rooms/{document=**} {
      allow read, write: if false;
    }

    // The room-level document is a deliberately small public lobby projection.
    match /v2RoomViews/{roomId} {
      allow read: if signedIn();
      allow write: if false;

      // Every private projection is addressed by Auth UID. A client cannot
      // enumerate or read another player's/spectator's view.
      match /viewers/{viewerUid} {
        allow get: if isOwner(viewerUid);
        allow list: if false;
        allow write: if false;
      }
    }

    // Idempotency records and audit events can include authoritative details.
    match /v2Events/{document=**} {
      allow read, write: if false;
    }

    // Spark-plan P2P directory. The coordinator browser owns only its current
    // room document. A successor may take the lease after 75 seconds without
    // a heartbeat; gameplay itself travels over WebRTC DataChannel.
    match /sparkRoomDirectory/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && roomId.matches('^[A-HJ-NP-Z2-9]{5}$')
        && request.resource.data.coordinatorUid == request.auth.uid
        && request.resource.data.coordinatorPeerId is string
        && request.resource.data.coordinatorPeerId.size() > 0
        && request.resource.data.coordinatorPeerId.size() <= 192
        && request.resource.data.visibility == 'public'
        && request.resource.data.heartbeatAt == request.time
        && (
          (
            request.resource.data.keys()
              .hasAll(['lastActivityAt', 'lastActivityAtMs', 'authorityRevision'])
            && request.resource.data.lastActivityAt == request.time
            && request.resource.data.authorityRevision is int
            && request.resource.data.authorityRevision >= 0
          )
          // Rolling-deploy compatibility. New coordinators migrate this shape
          // on their next heartbeat; abandoned documents use heartbeatAt.
          || !request.resource.data.keys()
            .hasAny(['lastActivityAt', 'lastActivityAtMs', 'authorityRevision'])
        );
      allow update: if signedIn()
        && request.resource.data.coordinatorPeerId is string
        && request.resource.data.coordinatorPeerId.size() > 0
        && request.resource.data.coordinatorPeerId.size() <= 192
        && request.resource.data.heartbeatAt == request.time
        && exists(/databases/$(database)/documents/sparkRoomSnapshots/$(roomId))
        && (
          (
            resource.data.keys().hasAll(['lastActivityAt', 'authorityRevision'])
            && request.resource.data.lastActivityAt == resource.data.lastActivityAt
            && request.resource.data.authorityRevision == resource.data.authorityRevision
          )
          || (
            !resource.data.keys()
              .hasAny(['lastActivityAt', 'lastActivityAtMs', 'authorityRevision'])
            && !request.resource.data.keys()
              .hasAny(['lastActivityAt', 'lastActivityAtMs', 'authorityRevision'])
          )
          || (
            request.resource.data.keys().hasAll(['lastActivityAt', 'authorityRevision'])
            && request.resource.data.lastActivityAt == request.time
            && request.resource.data.authorityRevision is int
            && request.resource.data.authorityRevision
              == get(/databases/$(database)/documents/sparkRoomSnapshots/$(roomId)).data.revision
            && (
              !resource.data.keys().hasAll(['lastActivityAt', 'authorityRevision'])
              || request.resource.data.authorityRevision > resource.data.authorityRevision
            )
          )
        )
        && (
          (
            resource.data.coordinatorUid == request.auth.uid
            && (
              (
                request.resource.data.coordinatorUid == resource.data.coordinatorUid
                && request.resource.data.coordinatorPeerId == resource.data.coordinatorPeerId
              )
              || (
                request.resource.data.coordinatorUid != resource.data.coordinatorUid
                && request.resource.data.coordinatorPeerId
                  == get(/databases/$(database)/documents/sparkRoomSnapshots/$(roomId))
                    .data.members[request.resource.data.coordinatorUid].peerId
              )
            )
          )
          || (
            request.time > resource.data.heartbeatAt + duration.value(300, 's')
            && request.resource.data.coordinatorUid == request.auth.uid
          )
        );
      // Snapshot-first deletion is mandatory. The owner may explicitly close a
      // room; any authenticated client may opportunistically reap a server-time
      // stale room, but only after its recovery snapshot is already absent.
      allow delete: if signedIn()
        && !exists(/databases/$(database)/documents/sparkRoomSnapshots/$(roomId))
        && (
          resource.data.coordinatorUid == request.auth.uid
          || isSparkRoomStale(roomId)
        );
    }

    // A full snapshot lets a peer take over if the coordinator tab closes.
    // Friends-only mode intentionally does not treat this as an anti-cheat
    // boundary; UI projections still hide cards during ordinary play.
    match /sparkRoomSnapshots/{roomId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && exists(/databases/$(database)/documents/sparkRoomDirectory/$(roomId))
        && get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.coordinatorUid
          == request.auth.uid
        && get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.coordinatorPeerId
          == request.resource.data.members[request.auth.uid].peerId
        && request.resource.data.coordinatorUid == request.auth.uid
        && request.resource.data.schemaVersion == 1;
      allow delete: if signedIn()
        && exists(/databases/$(database)/documents/sparkRoomDirectory/$(roomId))
        && (
          get(/databases/$(database)/documents/sparkRoomDirectory/$(roomId)).data.coordinatorUid
            == request.auth.uid
          || isSparkRoomStale(roomId)
        );
    }

    match /sparkPresence/{roomId}/members/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'peerId', 'online', 'role', 'name', 'lastSeenMs'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.peerId is string
        && request.resource.data.peerId.size() > 0
        && request.resource.data.peerId.size() <= 192
        && request.resource.data.online is bool
        && request.resource.data.role in ['player', 'spectator']
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 32
        && request.resource.data.lastSeenMs is int;
      allow delete: if isOwner(uid);
    }

    // Authenticated peers may send short-lived WebRTC signaling and fallback
    // mailbox packets. Rules bind senderUid to Auth; target queries are scoped
    // by targetUid. Payload authority is checked by the coordinator browser.
    match /sparkSignals/{roomId}/items/{messageId} {
      allow read: if signedIn()
        && (resource.data.targetUid == request.auth.uid
          || resource.data.senderUid == request.auth.uid);
      allow create: if signedIn()
        && roomId.matches('^[A-HJ-NP-Z2-9]{5}$')
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'senderUid', 'senderPeerId', 'targetUid', 'targetPeerId',
          'kind', 'payload', 'createdAtMs', 'expiresAtMs', 'createdAt'
        ])
        && request.resource.data.senderPeerId is string
        && request.resource.data.senderPeerId.size() > 0
        && request.resource.data.senderPeerId.size() <= 192
        && request.resource.data.targetPeerId is string
        && request.resource.data.targetPeerId.size() > 0
        && request.resource.data.targetPeerId.size() <= 192
        && request.resource.data.kind in ['offer', 'answer', 'ice']
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 65536
        && request.resource.data.createdAtMs is int
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs > request.time.toMillis()
        && request.resource.data.expiresAtMs <= request.time.toMillis() + 600000
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == request.time)
        && request.resource.data.expiresAtMs > request.resource.data.createdAtMs;
      allow delete: if signedIn()
        && (resource.data.targetUid == request.auth.uid
          || resource.data.senderUid == request.auth.uid);
      allow update: if false;
    }

    match /sparkMailboxes/{roomId}/items/{messageId} {
      allow read: if signedIn()
        && (resource.data.targetUid == request.auth.uid
          || resource.data.senderUid == request.auth.uid);
      allow create: if signedIn()
        && roomId.matches('^[A-HJ-NP-Z2-9]{5}$')
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'senderUid', 'senderPeerId', 'targetUid', 'targetPeerId',
          'kind', 'payload', 'createdAtMs', 'expiresAtMs', 'createdAt'
        ])
        && request.resource.data.senderPeerId is string
        && request.resource.data.senderPeerId.size() > 0
        && request.resource.data.senderPeerId.size() <= 192
        && request.resource.data.targetPeerId is string
        && request.resource.data.targetPeerId.size() > 0
        && request.resource.data.targetPeerId.size() <= 192
        && request.resource.data.kind == 'wire'
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 262144
        && request.resource.data.createdAtMs is int
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs > request.time.toMillis()
        && request.resource.data.expiresAtMs <= request.time.toMillis() + 600000
        && (!request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt == request.time)
        && request.resource.data.expiresAtMs > request.resource.data.createdAtMs;
      allow delete: if signedIn()
        && (resource.data.targetUid == request.auth.uid
          || resource.data.senderUid == request.auth.uid);
      allow update: if false;
    }

    // WebRTC is non-authoritative signaling only. Payloads are short-lived,
    // addressed to a room member, and cannot be updated after creation.
    match /webrtcRooms/{roomId}/signals/{signalId} {
      allow get, list: if isV2RoomMember(roomId, request.auth.uid)
        && (resource.data.senderUid == request.auth.uid
          || resource.data.targetUid == request.auth.uid);
      allow create: if roomId.matches('^[A-HJ-NP-Z2-9]{5}$')
        && signalId.size() <= 128
        && isV2RoomMember(roomId, request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'senderUid', 'targetUid', 'kind', 'payload', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.targetUid is string
        && isV2RoomMember(roomId, request.resource.data.targetUid)
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.kind in ['offer', 'answer', 'ice']
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 32768
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10, 'm');
      allow update, delete: if false;
    }

    // Firebase fallback for ephemeral presentation cues. These messages may
    // animate UI only; no card, turn, rank, or timer authority is accepted.
    match /webrtcRooms/{roomId}/cues/{cueId} {
      allow get, list: if isV2RoomMember(roomId, request.auth.uid);
      allow create: if roomId.matches('^[A-HJ-NP-Z2-9]{5}$')
        && cueId.size() <= 128
        && isV2RoomMember(roomId, request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'senderUid', 'kind', 'payload', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.kind in ['emote', 'focus', 'animation']
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 2048
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'm');
      allow update, delete: if false;
    }

    // Versioned user/avatar records are scoped to their authenticated owner.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'displayName', 'avatarId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1;
      allow delete: if false;
    }

    match /avatars/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      // Saved only through saveAvatarProfile so catalog IDs, ranges and size
      // are validated in the authoritative backend.
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
